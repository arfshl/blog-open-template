---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Generate a page for every blog tag
export async function getStaticPaths() {
  const postsPerPage = 6;
  const posts = await getCollection("blog");

  // Get unique tags from all posts
  const tags = [
    ...new Set(
      posts.flatMap((post) =>
        post.data.tags ?? []
      ),
    ),
  ];

  return tags.map((tag) => {
    const tagPosts = posts
      .filter((post) =>
        (post.data.tags ?? []).includes(tag)
      )
      .sort(
        (a, b) =>
          new Date(b.data.date).getTime() -
          new Date(a.data.date).getTime(),
      );

    return {
      params: {
        tag,
      },
      props: {
        tag,
        posts: tagPosts,
        currentPage: 1,
        totalPages: Math.ceil(tagPosts.length / postsPerPage),
      },
    };
  });
}

const postsPerPage = 6;

const {
  tag,
  posts,
  currentPage,
  totalPages,
} = Astro.props;

const pagePosts = posts.slice(0, postsPerPage);
---

<Layout
  title={`Tags: ${tag} - blog`}
  description={`Articles in ${tag} tag - blog`}
>
  <section>
    <div class="mb-8">
      <a
        class="text-xl font-bold text-black-100"
        href={`/blog-open-template/tag/${tag}`}
      >
        Tags: {tag}
      </a>

      <p class="mt-2 text-xs text-black-400 md:text-sm">
        {posts.length} article{posts.length !== 1 ? "s" : ""}
      </p>
    </div>

    <div class="space-y-4">
      {pagePosts.map((post) => (
        <article class="group rounded-xl border border-black-700 bg-white-800 p-5 shadow-lg sm:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0 flex-1">
              <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
                <a
                  href={`/blog-open-template/${post.data.category}/`}
                  class="rounded-md bg-blue-400/10 px-2 py-1 text-blue-300 transition-colors hover:text-blue-300!"
                >
                  {post.data.category}
                </a>

                <span class="text-black-500">
                  {new Date(post.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>

              <h2 class="mb-3 text-base font-bold text-black-100 md:text-lg">
                <a
                  href={`/blog-open-template/${post.data.category}/${post.data.slug}/`}
                  class="transition group-hover:text-black-400"
                >
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="text-xs text-black-400 md:text-sm">
                  {post.data.description}
                </p>
              )}
            </div>

            <div class="flex flex-wrap gap-2 self-start sm:self-center">
              {(post.data.tags ?? []).map((postTag) => (
                <a
                  href={`/blog-open-template/tag/${postTag}/`}
                  class="rounded bg-white-700 px-2 py-1 text-xs text-black-400"
                >
                  #{postTag}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    {
      totalPages > 1 && (
        <nav class="mt-8 flex w-full items-center justify-center gap-2 text-xs md:gap-4 md:text-sm">
          {currentPage > 1 && (
            <a
              href={`/blog-open-template/tag/${tag}/`}
              class="rounded-md border border-black-700 bg-white-800 px-2 py-2 text-black-300 transition hover:bg-white-700 md:rounded-lg md:px-4"
            >
              <span class="md:hidden">First</span>
              <span class="hidden md:inline">First</span>
            </a>
          )}

          {currentPage > 1 && (
            <a
              href={
                currentPage === 2
                  ? `/blog-open-template/tag/${tag}/`
                  : `/blog-open-template/tag/${tag}/page/${currentPage - 1}/`
              }
              class="rounded-md border border-black-700 bg-white-800 px-2 py-2 text-black-300 transition hover:bg-white-700 md:rounded-lg md:px-4"
            >
              <span class="md:hidden">Previous</span>
              <span class="hidden md:inline">Previous</span>
            </a>
          )}

          <span class="whitespace-nowrap text-black-500">
            Page {currentPage} of {totalPages}
          </span>

          {currentPage < totalPages && (
            <a
              href={`/blog-open-template/tag/${tag}/page/${currentPage + 1}/`}
              class="rounded-md border border-black-700 bg-white-800 px-2 py-2 text-black-300 transition hover:bg-white-700 md:rounded-lg md:px-4"
            >
              <span class="md:hidden">Next</span>
              <span class="hidden md:inline">Next</span>
            </a>
          )}

          {currentPage < totalPages && (
            <a
              href={`/blog-open-template/tag/${tag}/page/${totalPages}/`}
              class="rounded-md border border-black-700 bg-white-800 px-2 py-2 text-black-300 transition hover:bg-white-700 md:rounded-lg md:px-4"
            >
              <span class="md:hidden">Last</span>
              <span class="hidden md:inline">Last</span>
            </a>
          )}
        </nav>
      )
    }
  </section>
</Layout>